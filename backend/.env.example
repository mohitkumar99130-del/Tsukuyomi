# Tsukuyomi Backend Environment Variables

# Origin of the frontend (Express) server
FRONTEND_ORIGIN=http://localhost:3000

# ── SMTP (required for email alerts) ──────────────────────────────────────────
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
# Use an App Password if 2FA is enabled on Gmail.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TRUSTED_EMAIL=
SMTP_USE_TLS=true
