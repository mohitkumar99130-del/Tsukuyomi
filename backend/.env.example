# Tsukuyomi Backend Environment Variables

# Origin of the frontend (Express) server
FRONTEND_ORIGIN=http://localhost:3000

# ── SMTP (required for email alerts) ──────────────────────────────────────────
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
# Use an App Password if 2FA is enabled on Gmail.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TRUSTED_EMAIL=
SMTP_USE_TLS=true

# ── AI Evidence Intelligence (Phase 2) ────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# NEVER commit the actual key. Keep it only in backend/.env (gitignored).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Smart Safety Escalation (Phase 3) ─────────────────────────────────────────
PRIMARY_TRUSTED_EMAIL=
SECONDARY_TRUSTED_EMAIL=
CAMPUS_SECURITY_EMAIL=
ESCALATION_TIMEOUT_SECONDS=20
ENABLE_CAMPUS_ESCALATION=false
